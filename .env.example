# Copy to .env.local and fill in. .env.local is gitignored and must never be
# committed. `npm start` and `npm run dev:semanticizer` load it with Node's
# --env-file, so the file has to exist before either will start.

# Required. Used by the control plane to semanticize a demonstration, ground
# a binding, and drive the page-side agent loop.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.4 for all three roles.
# OPENAI_MODEL=
# OPENAI_BINDING_MODEL=
# OPENAI_AGENT_MODEL=

# Optional. Control plane port; defaults to 8787.
# PORT=8787
